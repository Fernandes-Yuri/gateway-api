# ─── PostgreSQL ───
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Groq AI (LLM) ───
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY_CHAT=gsk_your_groq_chat_key
GROQ_MODEL_CHAT=qwen/qwen3.8-27b
GROQ_MODEL_REST=qwen/qwen3.8-27b

# ─── Google Gemini (Vision / OCR Receitas) ───
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_VISION=gemini-1.5-flash


# ─── Gmail SMTP ───
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USERNAME=your_email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM_EMAIL=your_email@gmail.com
GMAIL_FROM_NAME=Braga Saude

# ─── Firebase Admin ───
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# ─── Piper TTS ───
PIPER_BIN=/path/to/piper_executable
PIPER_MODELS_DIR=/path/to/piper_models_directory

# ─── Server / URLs ───
PUBLIC_API_BASE_URL=https://your-domain.com
TRUST_PROXY_HEADERS=false
PYTHONUNBUFFERED=1
LANG=pt_BR.UTF-8

# ─── Optional: Custom Paths ───
# BRAGA_PROJECT_ROOT=/path/to/project
# DATASET_PATH=/path/to/dataset.jsonl
# AUDIO_CACHE_DIR=/path/to/audio_cache
# STORAGE_DIR=/path/to/storage
# STORAGE_EXAMS_DIR=/path/to/storage/exams
# DEVICES_PATH=/path/to/registered_devices.json
# BRAGA_RELEASES_DIR=/path/to/releases

# Taxa mensal fracionária para meses sem IPCA publicado (0.003 = 0,3%)
IPCA_MONTHLY_FALLBACK=0.003

# WhatsApp de captação Yuri (independente do canal de saúde retirado).
WHATSAPP_INTAKE_ENABLED=false
# Conversas WhatsApp: prazo absoluto fixo de 23h59 desde created_at.
# WHATSAPP_INTAKE_RETENTION_DAYS foi removido; valores antigos são ignorados.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
GROQ_API_KEY_WHATSAPP=
GROQ_MODEL_WHATSAPP=

# Verificação de integridade do conteúdo público das clínicas (somente GET).
# Coleta periódica das páginas públicas; consulta é autenticada no painel.
CONTEUDO_VERIFICACAO_ENABLED=false
CONTEUDO_INTERVALO_SEG=900
CONTEUDO_RETENCAO_DIAS=90
# Uma URL por linha; vazio usa a lista padrão do frontpage/hospitais/faq.
CONTEUDO_URLS=
# JSON {url: sha256} com o hash esperado por recurso (gerado no CI do site).
CONTEUDO_REF=
WHATSAPP_FFPROBE_BIN=ffprobe
WHATSAPP_FFMPEG_BIN=ffmpeg
# O cadastro da central consome ADMIN_TOTP_SECRET, o mesmo TOTP mestre do portal.

# ─── Autenticacao Admin (SPEC-10) ───
# Pepper secreto (HMAC-SHA256 pre-hash) para hashes Argon2id de admins.
# 64 caracteres hexadecimais (256 bits): python3 -c "import secrets; print(secrets.token_hex(32))"
# Injetar via AWS SSM Parameter Store / .env local com permissao 600.
# NAO commitar este valor.
AUTH_PEPPER_SECRET=
