# Gmail SMTP (não inclua credenciais reais neste arquivo)
# Ative a verificação em duas etapas na conta Google e gere uma senha de app.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USERNAME=nao-responda@gmail.com
GMAIL_SMTP_APP_PASSWORD=cole_a_senha_de_app_de_16_caracteres_aqui
GMAIL_FROM_EMAIL=nao-responda@gmail.com
GMAIL_FROM_NAME=Braga Saúde

# Apenas habilite quando o FastAPI estiver atrás de um proxy reverso confiável.
TRUST_PROXY_HEADERS=false
