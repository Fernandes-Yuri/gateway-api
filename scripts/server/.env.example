# Gmail SMTP Primário (ex: no-reply@bragasaude.online)
# As credenciais são lidas exclusivamente das variáveis de ambiente.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USERNAME=contato@bragasaude.online
GMAIL_SMTP_APP_PASSWORD=cole_a_senha_de_app_de_16_caracteres_aqui
GMAIL_FROM_EMAIL=no-reply@bragasaude.online
GMAIL_FROM_NAME=Braga Saúde
GMAIL_REPLY_TO=contato@bragasaude.online

# SMTP Fallback / Contingência (e-mail legado se o primário falhar)
FALLBACK_SMTP_HOST=smtp.gmail.com
FALLBACK_SMTP_PORT=465
FALLBACK_SMTP_USERNAME=contatobragasaude@gmail.com
FALLBACK_SMTP_APP_PASSWORD=senha_legada_aqui
FALLBACK_FROM_EMAIL=contatobragasaude@gmail.com
FALLBACK_FROM_NAME=Braga Saúde
FALLBACK_REPLY_TO=contatobragasaude@gmail.com

# Apenas habilite quando o FastAPI estiver atrás de um proxy reverso confiável.
TRUST_PROXY_HEADERS=false

# Google reCAPTCHA (validacao server-side dos tokens emitidos pelo front).
# Sem esta variavel, a verificacao fica desativada e NENHUM token e aprovado.
RECAPTCHA_SECRET=cole_a_chave_secreta_reCAPTCHA_aqui
