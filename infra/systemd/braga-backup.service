[Unit]
Description=Rotina de Backup Soberano Diario PostgreSQL para Cloudflare R2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/braga-gateway
EnvironmentFile=-/run/braga-saude/gateway.env
EnvironmentFile=-/etc/braga-saude/gateway.env
EnvironmentFile=-/etc/braga-saude/r2-backup.env
ExecStart=/home/ec2-user/braga-gateway/scripts/maintenance/backup_soberano_r2.sh
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
